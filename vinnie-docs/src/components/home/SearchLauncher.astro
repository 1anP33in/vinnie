---
// A large search field on the homepage that opens the site search dialog
// (the same full-text search as the header, also on Ctrl+K / ⌘K).
---

<vinnie-search-launcher>
  <button type="button" class="launcher" aria-label="Search the documentation">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
      ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
    >
    <span class="placeholder">Search the documentation…</span>
    <span class="keys"><kbd>Ctrl</kbd><kbd>K</kbd></span>
  </button>
</vinnie-search-launcher>

<script>
  class VinnieSearchLauncher extends HTMLElement {
    constructor() {
      super();
      this.querySelector("button")?.addEventListener("click", (event) => {
        // Starlight closes the dialog on any window click outside it; keep this
        // click from bubbling there right after the dialog opens.
        event.stopPropagation();
        const open = document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]");
        open?.click();
      });
    }
  }
  customElements.define("vinnie-search-launcher", VinnieSearchLauncher);
</script>

<style>
  vinnie-search-launcher {
    display: block;
    max-width: 36rem;
    margin: 1.5rem auto 0;
  }
  .launcher {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-base);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .launcher:hover,
  .launcher:focus-visible {
    border-color: var(--sl-color-accent);
    box-shadow: var(--vinnie-glow);
    outline: none;
  }
  .placeholder {
    flex: 1;
    text-align: start;
  }
  .keys {
    display: flex;
    gap: 0.25rem;
  }
  .keys kbd {
    display: inline-block;
    min-width: 1.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.3rem;
    background: transparent;
  }
  @media (max-width: 30rem) {
    .keys {
      display: none;
    }
  }
</style>
