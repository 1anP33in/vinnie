---
// How a request flows through Vinnie. Plain HTML (no image) so it stays
// sharp, searchable, and stacks vertically on narrow screens.
const base = import.meta.env.BASE_URL;
const steps = [
  { name: "You", detail: "Ask a question or describe a task", href: "user-guide/chat-interface/" },
  { name: "Desktop app", detail: "Tauri + React; shows plans, approvals, and diffs", href: "developer/architecture-overview/" },
  { name: "Agent runtime", detail: "Plans, picks tools, enforces limits", href: "agent-system/agent-execution-loop/" },
  { name: "Model provider", detail: "Ollama on your computer", href: "ollama/connecting-ollama/" },
  { name: "Tool registry", detail: "Native tools and MCP tools", href: "developer/tool-registry/" },
  { name: "Execution", detail: "Permission checks, then the Rust backend acts", href: "security/permission-architecture/" },
  { name: "Verification", detail: "Vinnie checks the result itself", href: "agent-system/verification-system/" },
];
---

<ol class="flow" aria-label="How Vinnie handles a request">
  {
    steps.map((s, i) => (
      <li class="step">
        <a href={`${base}${s.href}`}>
          <span class="index">{i + 1}</span>
          <span class="name">{s.name}</span>
          <span class="detail">{s.detail}</span>
        </a>
      </li>
    ))
  }
</ol>
<p class="loop-note">
  Steps 3–6 repeat until the task is done, a limit is reached, or you stop it. The model proposes actions; the
  application decides whether they may run.
</p>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    margin: 0;
  }
  .step a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.9rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .step a:hover,
  .step a:focus-visible {
    border-color: var(--sl-color-accent);
    box-shadow: var(--vinnie-glow);
  }
  .index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }
  .name {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .detail {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .loop-note {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
