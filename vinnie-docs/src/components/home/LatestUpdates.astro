---
// The most recent changelog entries (same data as the Changelog page).
import { CHANGELOG } from "../../data/changelog";

interface Props {
  limit?: number;
}
const { limit = 3 } = Astro.props;
const base = import.meta.env.BASE_URL;
const format = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<ul class="updates">
  {
    CHANGELOG.slice(0, limit).map((e) => (
      <li>
        <time datetime={e.date}>{format(e.date)}</time>
        <a href={`${base}${e.href}`}>{e.title}</a>
        <p>{e.summary}</p>
      </li>
    ))
  }
</ul>
<p class="all"><a href={`${base}additional/changelog/`}>Full changelog →</a></p>

<style>
  .updates {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border-inline-start: 2px solid var(--sl-color-accent-low);
  }
  .updates li {
    position: relative;
    margin: 0 0 1.1rem;
    padding-inline-start: 1.1rem;
  }
  .updates li::before {
    content: "";
    position: absolute;
    inset-inline-start: -0.4rem;
    top: 0.35rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    box-shadow: 0 0 10px rgb(34 211 238 / 0.5);
  }
  time {
    display: block;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .updates a {
    font-weight: 600;
  }
  .updates p {
    margin: 0.2rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .all {
    font-size: var(--sl-text-sm);
  }
</style>
